{
  "name": "packetcode-browser-tests",
  "private": true,
  "description": "Real-browser checks for the offline Packetcode HTML manual",
  "scripts": {
    "test:browser": "playwright test",
    "build:site": "node scripts/build-site.mjs",
    "preview:site": "node scripts/build-site.mjs --serve",
    "test:site": "playwright test --config=playwright.site.config.js",
    "screenshots:release": "python3 tools/screenshots/update_release.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@xterm/xterm": "6.0.0"
  }
}
